# Firebase Console → Project settings → Your apps → Web app → firebaseConfig
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxx

# Creator paroli. Agar VITE_CREATOR_EMAIL berilsa, parol Firebase Auth orqali tekshiriladi
# (xavfsiz rejim, firestore.rules dagi "request.auth != null" bilan ishlaydi).
VITE_CREATOR_PASSWORD=creator123
VITE_CREATOR_EMAIL=

# Asl fayllarni (PDF/DOCX) Firebase Storage'ga ham yuklash (Storage yoqilgan bo'lishi kerak)
VITE_USE_STORAGE=false

# VIP so'rovlari keladigan Telegram username (@ belgisiz)
VITE_ADMIN_TELEGRAM=

# VIP to'lovi uchun karta raqami va narx
VITE_CARD_NUMBER=8600 0000 0000 0000
VITE_VIP_PRICE=20 000

# Realtime Database (GAME-T): Console → Build → Realtime Database → yaratgach yuqoridagi URL
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
